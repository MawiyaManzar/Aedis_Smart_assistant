# Copy to .env.local (gitignored) and paste your key. Never commit a real key.
# Used only by the server-side route src/app/api/explain/route.ts; it is never sent to the browser.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=
# Optional: override the API endpoint (e.g. for tests).
OPENROUTER_API_URL=
