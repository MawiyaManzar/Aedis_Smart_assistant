# Local development placeholders. Copy to .env if you want to override them.
# .env is gitignored. Do not put production credentials in this file.

POSTGRES_USER=aedis_admin
POSTGRES_PASSWORD=aedis_password
POSTGRES_DB=aedis_db
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# If this machine already runs PostgreSQL on 5432 or Redis/Memurai on 6379,
# move only the host ports and the host URLs. Containers still use postgres:5432
# and redis:6379 on the Compose network.
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql+psycopg://aedis_app:aedis_app_password@localhost:5433/aedis_db
# MIGRATION_DATABASE_URL=postgresql+psycopg://aedis_admin:aedis_password@localhost:5433/aedis_db
# REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380/0

NEO4J_USER=neo4j
NEO4J_PASSWORD=aedis_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

ML_SERVICE_PORT=8000
MODEL_ENV=local
AEDIS_APP_PASSWORD=aedis_app_password
# The service connects as the restricted aedis_app role; migrations use the owner role.
DATABASE_URL=postgresql+psycopg://aedis_app:aedis_app_password@localhost:5432/aedis_db
MIGRATION_DATABASE_URL=postgresql+psycopg://aedis_admin:aedis_password@localhost:5432/aedis_db
